# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Persistent Cloud Source of Truth)
# VITE_SUPABASE_URL: Public Supabase project URL for client-side API calls
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# VITE_SUPABASE_ANON_KEY: Public Supabase anonymous API key for public & authenticated RLS-governed queries
VITE_SUPABASE_ANON_KEY="your-anon-key"

# SUPABASE_SERVICE_ROLE_KEY: Optional backend/server-only key (NEVER expose to browser/client-side code)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ADMIN_SECRET_KEY: Server-side secret passcode for administrative verification (NEVER exposed to client)
ADMIN_SECRET_KEY="IT402"
